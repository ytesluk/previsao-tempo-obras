# console = só imprime as mensagens (seguro para testes) | baileys = envia de verdade pelo WhatsApp
NOTIFICADOR=console

# true força o adaptador "console" mesmo que NOTIFICADOR=baileys (nada é enviado)
DRY_RUN=true

# Opcionais (os padrões já funcionam)
# AUTH_DIR=./auth
# STATE_FILE=./state/estado.json
# LOG_DIR=./logs
# Segundos que o boot espera o WhatsApp conectar antes de seguir (mensagens ficam em fila)
# CONEXAO_TIMEOUT_S=120
